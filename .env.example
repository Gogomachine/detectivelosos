# Telegram Bot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHANNEL_ID=@your_channel_id

# Admin Telegram chat IDs (comma-separated) - receives user messages from "Contact" button
# To find your chat ID: send /start to @userinfobot in Telegram
ADMIN_CHAT_IDS=123456789

# Anthropic Claude API
ANTHROPIC_API_KEY=your_anthropic_api_key

# Twitter/X API (для парсинга аккаунтов)
TWITTER_BEARER_TOKEN=your_twitter_bearer_token

# Database
DATABASE_PATH=data/casewalker.db

# Scheduling (UTC timezone)
MORNING_DIGEST_HOUR=7
EVENING_DIGEST_HOUR=19

# Parsing interval in minutes
PARSE_INTERVAL_MINUTES=30
